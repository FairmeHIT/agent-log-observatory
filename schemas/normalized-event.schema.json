{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NormalizedEvent",
  "version": "0.2.0",
  "type": "object",
  "required": ["schema_version", "event_id", "agent_object", "event_category", "occurred_at"],
  "properties": {
    "schema_version": { "type": "string", "const": "normalized-observation-0.2.0" },
    "event_id": { "type": ["string", "null"] },
    "agent_object": { "type": "string" },
    "installation_id": { "type": ["string", "null"] },
    "adapter_version": { "type": ["string", "null"] },
    "session_id": { "type": ["string", "null"] },
    "turn_id": { "type": ["string", "null"] },
    "step_id": { "type": ["string", "null"] },
    "llm_call_id": { "type": ["string", "null"] },
    "attempt_id": { "type": ["string", "null"] },
    "call_id": { "type": ["string", "null"] },
    "message_id": { "type": ["string", "null"] },
    "event_category": {
      "type": "string",
      "enum": ["llm.request", "llm.response", "tool.call", "tool.result", "agent.input", "step.start", "step.end", "other"]
    },
    "event_subtype": { "type": ["string", "null"] },
    "event_type_raw": { "type": ["string", "null"] },
    "occurred_at": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["ok", "error", "running", "cancelled", "unknown"] },
    "requested_model": { "type": ["string", "null"] },
    "routed_model": { "type": ["string", "null"] },
    "provider": { "type": ["string", "null"] },
    "tool_name": { "type": ["string", "null"] },
    "tool_kind": { "type": "string", "enum": ["skill", "mcp", "tool", "unknown"] }
  }
}

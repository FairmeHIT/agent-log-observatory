{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Doubao Client Observation Event",
  "type": "object",
  "required": ["schema_version", "collector_version", "agent_object", "event_id", "event_type", "occurred_at", "received_at", "timestamp_basis"],
  "properties": {
    "schema_version": {"const": "doubao-collector-event-0.1.0"},
    "collector_version": {"const": "0.3.0"},
    "agent_object": {"const": "doubao"},
    "installation_id": {"const": "default"},
    "event_id": {"type": "string"},
    "event_type": {"enum": ["client.request", "client.headers", "client.end", "stream.text", "reply.end", "tool.call", "tool.result", "human.request", "human.decision", "task.status", "capture.gap"]},
    "source_seq": {"type": "integer", "minimum": 0},
    "capture_epoch": {"type": "string"},
    "native_event_id": {"type": ["string", "null"]},
    "request_id": {"type": ["string", "null"]},
    "conversation_id": {"type": ["string", "null"]},
    "trajectory_session_id": {"type": ["string", "null"]},
    "message_id": {"type": ["string", "null"]},
    "agent_id": {"type": ["string", "null"]},
    "sandbox_id": {"type": ["string", "null"]},
    "tool_call_id": {"type": ["string", "null"]},
    "tool_name": {"type": ["string", "null"]},
    "approval_id": {"type": ["string", "null"]},
    "ask_human_type": {"type": ["string", "null"]},
    "decision": {"enum": ["allow", "deny", "modified", null]},
    "task_status": {"enum": ["running", "waiting", "completed", "failed", "cancelled", null]},
    "status": {"enum": ["ok", "error", "running", "cancelled", "unknown"]},
    "exit_code": {"type": ["integer", "null"]},
    "http_status": {"type": ["integer", "null"]},
    "reason": {"type": ["string", "null"]},
    "parse_errors": {"type": "integer", "minimum": 0},
    "text_chars": {"type": "integer", "minimum": 0},
    "text_revision": {"type": "boolean"},
    "delayed": {"type": "boolean"},
    "requested_model": {"type": ["string", "null"]},
    "configured_context_window": {"type": ["number", "null"]},
    "occurred_at": {"type": ["number", "null"]},
    "received_at": {"type": ["number", "null"]},
    "timestamp_basis": {"enum": ["cdp_monotonic", "receipt"]}
  },
  "additionalProperties": false
}

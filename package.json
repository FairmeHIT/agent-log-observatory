{
  "name": "agent-log-observatory",
  "version": "0.0.9",
  "description": "跨 Agent 的本地日志观测与统计分析工具。将散落在各 Agent 客户端中的本地日志进行标准化处理、聚合和统一可视化。",
  "author": "lihuafu (https://github.com/FairmeHIT)",
  "license": "Apache-2.0",
  "main": "server.mjs",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test": "node --test tests/test-*.mjs",
    "release": "node scripts/export-release.mjs"
  },
  "dependencies": {
    "better-sqlite3": "file:vendor/npm/better-sqlite3-13.0.3.tgz",
    "node-addon-api": "file:vendor/npm/node-addon-api-8.9.2.tgz"
  },
  "private": false,
  "engines": {
    "node": ">=24 <25"
  }
}
